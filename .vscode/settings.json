{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["./work"],
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "editor.tabSize": 4,
  "editor.wordWrap": "on",
  "search.exclude": {
    "**/.venv": true,
    "**/outputs": true,
    "**/inputs": true,
    "**/work/ocr_bounds": true,
    "**/work/education_final_visual_qa": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/outputs/**": true,
    "**/work/education_final_visual_qa/**": true
  },
  "terminal.integrated.env.windows": {"PYTHONIOENCODING": "utf-8"}
}
